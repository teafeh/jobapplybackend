# Server and frontend
PORT=5000
CLIENT_ORIGIN=http://localhost:5174

# Google Gemini API
# Create an API key in Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
# Optional. The backend adds the required "models/" prefix automatically.
GEMINI_MODEL=gemini-3.6-flash

# Google OAuth for Gmail sending
# Configure this callback URL in your Google Cloud OAuth client.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

